  "dialogues": [
    {
      "dialogueId": "dialogue.npc.trader",
      "archetype": "Trader",
      "greetingEn": "Frontier Exchange is open. I can route trade or contracts.",
      "greetingRu": "Frontier Exchange открыт. Могу перейти к торговле или контрактам.",
      "farewellEn": "Safe travels.",
      "farewellRu": "Счастливого пути.",
      "options": [
        {
          "optionId": "dialogue_option.npc.trader.trade",
          "textEn": "Open trade.",
          "textRu": "Открыть торговлю.",
          "condition": "reputation>=-100",
          "action": "OpenTrade",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Market interface requested.",
          "consequenceRu": "Запрошен интерфейс рынка."
        },
        {
          "optionId": "dialogue_option.npc.trader.missions",
          "textEn": "Show available contracts.",
          "textRu": "Показать доступные контракты.",
          "condition": "reputation>=-100",
          "action": "OpenMissions",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Mission journal requested.",
          "consequenceRu": "Запрошен журнал заданий."
        },
        {
          "optionId": "dialogue_option.npc.trader.close",
          "textEn": "Goodbye.",
          "textRu": "До встречи.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.technician",
      "archetype": "Technician",
      "greetingEn": "Mara Quill. Field systems and repair diagnostics are my department.",
      "greetingRu": "Мара Квилл. Полевые системы и ремонтная диагностика — моя работа.",
      "farewellEn": "Keep your systems inside tolerance.",
      "farewellRu": "Держите системы в рабочих допусках.",
      "options": [
        {
          "optionId": "dialogue_option.npc.technician.repair",
          "textEn": "Any repair advice?",
          "textRu": "Что посоветуете по ремонту?",
          "condition": "reputation>=-20",
          "action": "RepairHint",
          "minimumReputation": -20,
          "reputationDelta": 1,
          "consequenceEn": "Repair diagnostics shared; first useful interaction improves reputation.",
          "consequenceRu": "Передана ремонтная диагностика; первое полезное общение повышает репутацию."
        },
        {
          "optionId": "dialogue_option.npc.technician.close",
          "textEn": "Thanks.",
          "textRu": "Спасибо.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.pilot",
      "archetype": "Pilot",
      "greetingEn": "Soren Vale. I fly the local lanes when the weather permits.",
      "greetingRu": "Сорен Вейл. Летаю по местным трассам, когда позволяет погода.",
      "farewellEn": "Watch the approach vector.",
      "farewellRu": "Следите за вектором захода.",
      "options": [
        {
          "optionId": "dialogue_option.npc.pilot.flight",
          "textEn": "Tell me about the local approach.",
          "textRu": "Расскажите о местном заходе.",
          "condition": "reputation>=-40",
          "action": "FlightHint",
          "minimumReputation": -40,
          "reputationDelta": 1,
          "consequenceEn": "Local flight note shared.",
          "consequenceRu": "Передана заметка о местных полётах."
        },
        {
          "optionId": "dialogue_option.npc.pilot.close",
          "textEn": "Clear skies.",
          "textRu": "Чистого неба.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.scientist",
      "archetype": "Scientist",
      "greetingEn": "Dr. Eren Sol. The local biosphere is more complex than the first survey suggested.",
      "greetingRu": "Доктор Эрен Сол. Местная биосфера сложнее, чем показала первая разведка.",
      "farewellEn": "Do not contaminate the samples.",
      "farewellRu": "Не загрязняйте образцы.",
      "options": [
        {
          "optionId": "dialogue_option.npc.scientist.science",
          "textEn": "What should I scan?",
          "textRu": "Что стоит сканировать?",
          "condition": "reputation>=-30",
          "action": "ScienceHint",
          "minimumReputation": -30,
          "reputationDelta": 1,
          "consequenceEn": "Survey priority shared.",
          "consequenceRu": "Передан приоритет исследований."
        },
        {
          "optionId": "dialogue_option.npc.scientist.protect",
          "textEn": "I am here to secure your field work.",
          "textRu": "Я здесь, чтобы обеспечить безопасность полевых работ.",
          "condition": "reputation>=-50",
          "action": "AcknowledgeProtection",
          "minimumReputation": -50,
          "reputationDelta": 1,
          "consequenceEn": "Protection objective acknowledged.",
          "consequenceRu": "Цель по защите подтверждена."
        },
        {
          "optionId": "dialogue_option.npc.scientist.close",
          "textEn": "Good luck with the survey.",
          "textRu": "Удачи с исследованием.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.guard",
      "archetype": "Guard",
      "greetingEn": "Vera Kane, Aegis Compact. This perimeter is under observation.",
      "greetingRu": "Вера Кейн, Aegis Compact. Этот периметр находится под наблюдением.",
      "farewellEn": "Stay clear of restricted equipment.",
      "farewellRu": "Не приближайтесь к оборудованию с ограниченным доступом.",
      "options": [
        {
          "optionId": "dialogue_option.npc.guard.briefing",
          "textEn": "Any security concerns?",
          "textRu": "Есть угрозы безопасности?",
          "condition": "reputation>=0",
          "action": "GuardBriefing",
          "minimumReputation": 0,
          "reputationDelta": 1,
          "consequenceEn": "Security briefing shared.",
          "consequenceRu": "Передана сводка безопасности."
        },
        {
          "optionId": "dialogue_option.npc.guard.close",
          "textEn": "Understood.",
          "textRu": "Понятно.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.guild_representative",
      "archetype": "GuildRepresentative",
      "greetingEn": "Talia Nox. I coordinate field contracts for the Academy network.",
      "greetingRu": "Талия Нокс. Я координирую полевые контракты сети Академии.",
      "farewellEn": "The board refreshes as capabilities change.",
      "farewellRu": "Доска заданий обновляется по мере изменения возможностей.",
      "options": [
        {
          "optionId": "dialogue_option.npc.guild.missions",
          "textEn": "Open the mission board.",
          "textRu": "Открыть доску заданий.",
          "condition": "reputation>=-50",
          "action": "OpenMissions",
          "minimumReputation": -50,
          "reputationDelta": 1,
          "consequenceEn": "Mission journal requested.",
          "consequenceRu": "Запрошен журнал заданий."
        },
        {
          "optionId": "dialogue_option.npc.guild.close",
          "textEn": "Later.",
          "textRu": "Позже.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.traveler",
      "archetype": "Traveler",
      "greetingEn": "Yun Ardent. I thought this route would be quieter.",
      "greetingRu": "Юн Ардент. Я думал, этот маршрут будет спокойнее.",
      "farewellEn": "I will keep moving.",
      "farewellRu": "Я продолжу путь.",
      "options": [
        {
          "optionId": "dialogue_option.npc.traveler.story",
          "textEn": "What did you see on the road?",
          "textRu": "Что вы видели по дороге?",
          "condition": "reputation>=-40",
          "action": "TravelerStory",
          "minimumReputation": -40,
          "reputationDelta": 1,
          "consequenceEn": "A local rumor was shared.",
          "consequenceRu": "Передан местный слух."
        },
        {
          "optionId": "dialogue_option.npc.traveler.protect",
          "textEn": "I can cover your route from here.",
          "textRu": "Я могу прикрыть ваш маршрут отсюда.",
          "condition": "reputation>=-50",
          "action": "AcknowledgeProtection",
          "minimumReputation": -50,
          "reputationDelta": 1,
          "consequenceEn": "Protection objective acknowledged.",
          "consequenceRu": "Цель по защите подтверждена."
        },
        {
          "optionId": "dialogue_option.npc.traveler.close",
          "textEn": "Take care.",
          "textRu": "Берегите себя.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
    },
    {
      "dialogueId": "dialogue.npc.opponent",
      "archetype": "Opponent",
      "greetingEn": "Wrong place. Leave before I make the decision for you.",
      "greetingRu": "Не то место. Уходи, пока я не решил за тебя.",
      "farewellEn": "Run.",
      "farewellRu": "Беги.",
      "options": [
        {
          "optionId": "dialogue_option.npc.opponent.warning",
          "textEn": "Stand down.",
          "textRu": "Оружие вниз.",
          "condition": "always",
          "action": "HostileWarning",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "The opponent remains hostile.",
          "consequenceRu": "Противник остаётся враждебным."
        },
        {
          "optionId": "dialogue_option.npc.opponent.close",
          "textEn": "Back away.",
          "textRu": "Отойти.",
          "condition": "always",
          "action": "Close",
          "minimumReputation": -100,
          "reputationDelta": 0,
          "consequenceEn": "Dialogue closed.",
          "consequenceRu": "Диалог закрыт."
        }
      ]
